# OmniShield AI - development defaults. Do not deploy with AUTH_MODE=off.
APP_NAME="OmniShield AI"
ENVIRONMENT="development"
DEBUG=false
RATE_LIMIT_PER_MINUTE=60

# Local persistent incidents. Production multi-instance deployments should use a shared DB.
INCIDENT_STORE="sqlite"
INCIDENT_STORE_PATH="data/incidents.db"

# Authentication modes: off (local development only), api_key (server-to-server), supabase (browser JWTs).
AUTH_MODE="off"
API_KEY=""
SUPABASE_URL=""
SUPABASE_JWT_AUDIENCE="authenticated"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Optional Prompt Injection classifier (Transformers, locally cached). Existing rule scan still works if off.
ENABLE_PROMPT_ML=false
PROMPT_ML_MODEL="protectai/deberta-v3-base-prompt-injection-v2"
PROMPT_ML_THRESHOLD=0.80
# ProtectAI default card: class 0=benign, class 1=injection. Update if changing the model.
PROMPT_ML_LABELS="SAFE,INJECTION"
PROMPT_ML_LOCAL_FILES_ONLY=true

# Optional locally-hosted text models. Weights are not bundled in the project ZIP.
# Run: pip install -r requirements-ml.txt && python scripts/download_models.py --tasks sms email url
# After download, point *_ML_MODEL to a local model directory, e.g. ./models/sms
ENABLE_SMS_ML=false
SMS_ML_MODEL="omarash/sms-spam-distilbert"
# Only used if model config has generic LABEL_0/LABEL_1 values. Check the model card/model config first.
SMS_ML_LABELS=""
ENABLE_EMAIL_ML=false
EMAIL_ML_MODEL="dima806/phishing-email-detection"
EMAIL_ML_LABELS=""
ENABLE_URL_ML=false
URL_ML_MODEL="ealvaradob/bert-finetuned-phishing"
URL_ML_LABELS=""
# Requires a task-specific trained model. Generic text classification is not invoice-fraud validation.
ENABLE_INVOICE_ML=false
INVOICE_ML_MODEL=""
INVOICE_ML_LABELS=""
DOMAIN_ML_THRESHOLD=0.80
TEXT_ML_LOCAL_FILES_ONLY=true
# Optional local NER to detect names, organizations and locations (pattern DLP remains primary).
ENABLE_DLP_NER=false
DLP_NER_MODEL="dslim/bert-base-NER"

# Optional Google Web Risk URL reputation. No URL is fetched/opened by OmniShield itself.
GOOGLE_WEB_RISK_API_KEY=""
WEB_RISK_TIMEOUT_SECONDS=3

# Optional file malware scanning (ClamAV installed in runtime) and separately managed private inference endpoint.
CLAMAV_BINARY="clamscan"
CLAMAV_TIMEOUT_SECONDS=12
MAX_UPLOAD_BYTES=15728640
MALWARE_INFERENCE_URL=""
MALWARE_INFERENCE_TOKEN=""

# Optional Rook-1 enrichment; if set, review data-sharing implications before production use.
ROOK_SERVICE_URL=""
